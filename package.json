  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite",
